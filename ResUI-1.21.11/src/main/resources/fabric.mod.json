  "icon": "assets/resui/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.resui.client.ResUiClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.0"
  }
}